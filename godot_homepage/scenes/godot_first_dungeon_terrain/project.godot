; E24 offline-only terrain editor project. The React/Vite game never loads this project.
config_version=5

[application]
config/name="First Dungeon Terrain Editor"
run/main_scene="res://scenes/first_dungeon_terrain_preview.tscn"

[display]
window/size/viewport_width=512
window/size/viewport_height=512
window/size/window_width_override=512
window/size/window_height_override=512

[rendering]
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
